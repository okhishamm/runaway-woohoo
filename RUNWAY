local script1 = [[
local Players = game:GetService("Players")

local player = Players.LocalPlayer

-- Exact Activate prompt
local prompt = workspace
	:WaitForChild("Map")
	:WaitForChild("Buildings")
	:WaitForChild("CustomsFinal")
	:WaitForChild("CustomsBuilding")
	:WaitForChild("FinalDoor")
	:WaitForChild("Command")
	:WaitForChild("CommandButton")
	:WaitForChild("Prompt")
	:WaitForChild("ProximityPrompt")

-- Get the part containing the prompt
local targetPart = prompt.Parent

local function getCharacter()
	local character = player.Character or player.CharacterAdded:Wait()
	local root = character:WaitForChild("HumanoidRootPart")
	return character, root
end

local function getTargetPosition()
	if targetPart:IsA("BasePart") then
		return targetPart.Position
	elseif targetPart:IsA("Model") then
		return targetPart:GetPivot().Position
	end

	-- Fallback: use the prompt's world position
	return prompt.WorldPosition
end

local character, root = getCharacter()
local targetPosition = getTargetPosition()

-- Put the player slightly above the Activate button
character:PivotTo(
	CFrame.new(targetPosition + Vector3.new(0, 4, 0))
)

root.AssemblyLinearVelocity = Vector3.zero
root.AssemblyAngularVelocity = Vector3.zero

print("Teleported to Activate:", targetPosition)-- SCRIPT 1 HERE
]]

local script2 = [[
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local RANGE = 2500
local DAMAGE = 1000
local INTERVAL = 0.2

local function getRoot(character)
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function damageNearbyNPCs(player)
	local character = player.Character
	local root = getRoot(character)

	if not root then
		return
	end

	local npcFolder = workspace:FindFirstChild("NPCs")
	if not npcFolder then
		return
	end

	for _, npc in ipairs(npcFolder:GetChildren()) do
		if npc:IsA("Model") then
			local humanoid = npc:FindFirstChildOfClass("Humanoid")
			local npcRoot =
				npc:FindFirstChild("HumanoidRootPart")
				or npc.PrimaryPart

			if humanoid
				and npcRoot
				and humanoid.Health > 0 then

				local distance =
					(npcRoot.Position - root.Position).Magnitude

				if distance <= RANGE then
					humanoid:TakeDamage(DAMAGE)
				end
			end
		end
	end
end

task.spawn(function()
	while true do
		for _, player in ipairs(Players:GetPlayers()) do
			damageNearbyNPCs(player)
		end

		task.wait(INTERVAL)
	end
end)-- SCRIPT 2 HERE
]]

local function run(code, name)
    local fn, err = loadstring(code)

    if not fn then
        warn("Failed to load " .. name .. ": " .. tostring(err))
        return false
    end

    local success, result = pcall(fn)

    if not success then
        warn("Failed to run " .. name .. ": " .. tostring(result))
        return false
    end

    print(name .. " finished")
    return true
end

run(script1, "Script 1")
run(script2, "Script 2")

print("All scripts finished")
