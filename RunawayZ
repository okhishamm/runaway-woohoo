local script2 = [[
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local RANGE = 250
local DAMAGE = 1000
local INTERVAL = 0.2

local function getRoot(character)
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function damageNearbyNPCs(player)
	local character = player.Character
	local root = getRoot(character)

	if not root then
		return
	end

	local npcFolder = workspace:FindFirstChild("NPCs")
	if not npcFolder then
		return
	end

	for _, npc in ipairs(npcFolder:GetChildren()) do
		if npc:IsA("Model") then
			local humanoid = npc:FindFirstChildOfClass("Humanoid")
			local npcRoot =
				npc:FindFirstChild("HumanoidRootPart")
				or npc.PrimaryPart

			if humanoid
				and npcRoot
				and humanoid.Health > 0 then

				local distance =
					(npcRoot.Position - root.Position).Magnitude

				if distance <= RANGE then
					humanoid:TakeDamage(DAMAGE)
				end
			end
		end
	end
end

task.spawn(function()
	while true do
		for _, player in ipairs(Players:GetPlayers()) do
			damageNearbyNPCs(player)
		end

		task.wait(INTERVAL)
	end
end)
]]

local script3 = [[
--========================================================
-- COORDINATE TELEPORTER
--========================================================

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

--========================================================
-- CONFIG
--========================================================

local AUTO_TELEPORT = true
local SHOW_GUI = false

-- CHANGE THESE WHENEVER YOU WANT
local AUTO_X = 701.421
local AUTO_Y = 2011.231
local AUTO_Z = 83592.812

-- Automatically try to find ground underneath the target
local FIND_GROUND = true

-- How far above the ground to place the character
local GROUND_OFFSET = 4

-- How far the ground raycast searches
local GROUND_RAY_HEIGHT = 500
local GROUND_RAY_DEPTH = 1500

local GUI_NAME = "CoordinateTeleporter"

--========================================================
-- CHARACTER
--========================================================

local function getCharacter()
	local character = player.Character

	if not character then
		return nil, nil
	end

	local root = character:FindFirstChild("HumanoidRootPart")

	return character, root
end

--========================================================
-- GROUND FINDER
--========================================================

local function findGround(position, character)

	local rayOrigin =
		position + Vector3.new(0, GROUND_RAY_HEIGHT, 0)

	local rayDirection =
		Vector3.new(0, -GROUND_RAY_DEPTH, 0)

	local params = RaycastParams.new()

	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {character}

	local result = workspace:Raycast(
		rayOrigin,
		rayDirection,
		params
	)

	if result then
		return result.Position
	end

	return nil
end

--========================================================
-- TELEPORT FUNCTION
--========================================================

local function teleportTo(position)

	local character, root = getCharacter()

	if not character or not root then
		return false, "Character not found"
	end

	-- First go to requested coordinates
	character:PivotTo(CFrame.new(position))

	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero

	-- Try finding ground
	if FIND_GROUND then

		task.wait(0.05)

		local ground = findGround(position, character)

		if ground then

			local safePosition =
				ground + Vector3.new(0, GROUND_OFFSET, 0)

			character:PivotTo(
				CFrame.new(safePosition)
			)

			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero

			return true, safePosition
		end
	end

	return true, position
end

--========================================================
-- AUTO TELEPORT
--========================================================

if AUTO_TELEPORT then

	task.spawn(function()

		-- Wait for character
		local character, root

		repeat
			task.wait()
			character, root = getCharacter()
		until character and root

		task.wait(0.1)

		local target = Vector3.new(
			AUTO_X,
			AUTO_Y,
			AUTO_Z
		)

		local success, result = teleportTo(target)

		if success then
			print(
				"[Coordinate Teleporter] Auto teleported to:",
				result
			)
		else
			warn(
				"[Coordinate Teleporter]",
				result
			)
		end

	end)

end

